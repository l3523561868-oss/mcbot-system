# 统一换行符，避免 shell 脚本被 Windows 的 CRLF 破坏（在 Termux 里会报 /bin/sh^M）
* text=auto

*.sh   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

.nvmrc          text eol=lf
.python-version text eol=lf

*.png binary
*.ico binary
