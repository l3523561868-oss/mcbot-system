<?xml version="1.0" encoding="utf-8"?>
<!-- 允许 http 明文访问（控制台走 http://IP:8900，Android 默认禁明文，必须放开） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
